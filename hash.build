// The package's C, until Goose's stdlib has what it does (docs/decisions.md):
// SHA-1's and SHA-256's compression functions on the CPU's SHA instructions,
// and the OS's secure random source. Each function that uses the instructions
// carries its own target attribute, so the C needs no -march and runs on any
// CPU of its architecture.
c_sources = ["shim/sha.c", "shim/random.c"];
// BCryptGenRandom, for shim/random.c, with MSVC and with clang alike.
c_libs_windows = ["bcrypt"];
// The shims' _Static_assert is C11, which MSVC takes only when asked.
c_flags_msvc = ["/std:c11"];
// build/ holds the compiler scripts/goose.sh fetches, whose stdlib declares the
// runtime's extern fns.
exclude = ["build"];
