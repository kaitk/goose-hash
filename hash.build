// The package's C: SHA-1's and SHA-256's compression functions on the CPU's
// SHA instructions, until Goose's stdlib has them (docs/decisions.md). Each
// function that uses the instructions carries its own target attribute, so
// the C needs no -march and runs on any CPU of its architecture.
c_sources = ["shim/sha.c"];
// The shim's _Static_assert is C11, which MSVC takes only when asked.
c_flags_msvc = ["/std:c11"];
// build/ holds the compiler scripts/goose.sh fetches, whose stdlib declares the
// runtime's extern fns.
exclude = ["build"];
